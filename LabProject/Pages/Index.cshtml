@page
@model IndexModel

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    body {
        background: linear-gradient(120deg, #a1c4fd 0%, #c2e9fb 100%);
        font-family: 'Arial', sans-serif;
        min-height: 100vh;
        justify-content: center;
        align-items: center;
    }

    .container {
        max-width: 1200px;
        width: 100%;
        padding: 20px;
    }

    h2 {
        color: #0d6efd;
        margin-bottom: 20px;
        text-align: center;
        font-weight: bold;
    }

    .form-control {
        border-radius: 10px;
        border: 1px solid #ddd;
        padding: 12px;
        transition: all 0.3s ease;
        box-shadow: none;
    }

    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 5px rgba(13, 110, 253, 0.5);
    }

    .btn {
        border-radius: 5px;
        font-weight: bold;
        text-transform: uppercase;
        transition: transform 0.3s ease, opacity 0.3s ease;
    }

    .btn-primary,
    .btn-warning,
    .btn-success,
    .btn-info,
    .btn-danger {
        transition: all 0.3s ease;
    }

    .btn:hover {
        opacity: 0.9;
        transform: scale(1.05);
    }

    .btn-primary {
        background-color: #0d6efd;
        border: none;
    }

    .btn-warning {
        background-color: #ffc107;
        border: none;
    }

    .btn-success {
        background-color: #28a745;
        border: none;
    }

    .btn-info {
        background-color: #17a2b8;
        border: none;
    }

    .btn-danger {
        background-color: #dc3545;
        border: none;
    }

    .pagination .page-link {
        background-color: #f8f9fa;
        color: #333;
        border: 1px solid #ddd;
        border-radius: 5px;
        transition: background-color 0.3s ease, color 0.3s ease;
    }

    .pagination .page-item.active .page-link {
        background-color: #0d6efd;
        color: white;
    }

    .pagination .page-item:hover .page-link {
        background-color: #ddd;
    }

    .table-striped tbody tr:nth-child(odd) {
        background-color: #f9f9f9;
    }

    .form-check-inline {
        margin-right: 15px;
    }

    .line {
        border-top: 2px solid #0d6efd;
        margin: 20px 0;
    }

    .right-side-container {
        background-color: white;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    .filter-export-container {
        padding: 20px;
        background-color: #ffffff;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
    }
</style>

<div class="container mt-4">
    <div class="row">

        <div class="col-md-6">
            <div class="filter-export-container">
            <form method="post">
                <input type="hidden" asp-for="EditId" />

                <div class="form-group mb-3">
                    <label asp-for="NewClass.ClassName">Class Name</label>
                    <input asp-for="NewClass.ClassName" class="form-control" />
                    <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="NewClass.StudentCount">Student Count</label>
                    <input asp-for="NewClass.StudentCount" class="form-control" />
                    <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="NewClass.Description">Description</label>
                    <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                </div>

                <div class="mt-3">
                    @if (Model.EditId == 0)
                    {
                        <button type="submit" asp-page-handler="Add" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-1"></i>Add Class
                        </button>
                    }
                    else
                    {
                        <button type="submit" asp-page-handler="Edit" asp-route-id="@Model.EditId" class="btn btn-warning">
                            <i class="bi bi-pencil-square me-1"></i>Update
                        </button>
                        <a href="/" class="btn btn-secondary">
                            <i class="bi bi-x-circle me-1"></i>Cancel
                        </a>
                    }
                </div>
            </form>
            </div>
        </div>

        <div class="col-md-6">

            <!-- Filter and Export Section Outside of the White Container -->
            <div class="filter-export-container">
                <form method="get" id="filterForm" class="mb-3">
                    <div class="form-group">
                        <label for="FilterClassName">Filter by Class Name</label>
                        <input type="text" name="FilterClassName" value="@Model.FilterClassName" class="form-control"
                               placeholder="Filter by Class Name" oninput="debouncedFilter()" />
                    </div>
                </form></div>
                <div class="filter-export-container">

                <form method="post" asp-page-handler="Export" onsubmit="return collectColumns()" id="exportForm">
                    <input type="hidden" name="filtered" value="true" />
                    <input type="hidden" name="selectedColumns" id="selectedColumns" />
                    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                    <input type="hidden" name="FilterClassName" value="@Model.FilterClassName" />

                    <div class="form-check form-check-inline">
                        <input class="form-check-input column-checkbox" type="checkbox" value="ClassName" checked />
                        <label class="form-check-label">Class Name</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input column-checkbox" type="checkbox" value="StudentCount" checked />
                        <label class="form-check-label">Student Count</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input column-checkbox" type="checkbox" value="Description" checked />
                        <label class="form-check-label">Description</label>
                    </div>

                    <button type="submit" class="btn btn-success btn-sm ms-3">
                        <i class="bi bi-download"></i> Export
                    </button>
                </form>
            </div>


            <!-- Table Section Inside the White Container -->
            <div class="right-side-container">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Class Name</th>
                            <th>Students</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.FilteredClasses)
                        {
                            <tr>
                                <td>@item.ClassName</td>
                                <td>@item.StudentCount</td>
                                <td>@item.Description</td>
                                <td>
                                    <form method="post" class="d-inline">
                                        <a asp-page="/Index" asp-route-editId="@item.Id" class="btn btn-sm btn-info">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </a>
                                        <button type="submit" asp-page-handler="Delete" asp-route-id="@item.Id"
                                                class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <nav>
                    <ul class="pagination">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-page="/Index" asp-route-PageNumber="@i"
                                   asp-route-FilterClassName="@Model.FilterClassName">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        let debounceTimer;
        function debouncedFilter() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                document.getElementById('filterForm').submit();
            }, 500);
        }

        function collectColumns() {
            const selectedColumns = [];
            document.querySelectorAll('.column-checkbox:checked').forEach((checkbox) => {
                selectedColumns.push(checkbox.value);
            });
            document.getElementById('selectedColumns').value = selectedColumns.join(',');
            return true;
        }
    </script>
}
